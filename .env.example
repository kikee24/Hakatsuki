# Copy to .env and fill in locally. In GitHub Actions these come from repository secrets.
# Never commit real values.

# --- betsson.com (EN / EUR) ---
BETSSON_COM_FUNDED_USERNAME=
BETSSON_COM_FUNDED_PASSWORD=
BETSSON_COM_EMPTY_USERNAME=
BETSSON_COM_EMPTY_PASSWORD=
# Optional, e.g. http://host:port if the market is geo-restricted
BETSSON_COM_PROXY_SERVER=

# --- betsson.pe (ES / PEN) ---
BETSSON_PE_FUNDED_USERNAME=
BETSSON_PE_FUNDED_PASSWORD=
BETSSON_PE_EMPTY_USERNAME=
BETSSON_PE_EMPTY_PASSWORD=
BETSSON_PE_PROXY_SERVER=

# --- Optional AI vision fallback ---
ANTHROPIC_API_KEY=
