# Copy to .env and fill in locally. Never commit real values.
# No credentials: Betsson's bot protection blocks automated logins, so each account is logged in by
# hand once in its own browser window (npm run session:funded / session:empty) and tests reuse it.

# Markets to run (comma-separated). Default: betsson-es
MARKETS=betsson-es

# Browser for launched pages: chrome | msedge | chromium (bundled). Default on Windows: installed
# Chrome, else Edge. Bundled Chromium elsewhere.
BROWSER_CHANNEL=
# Executable for the hand-logged-in windows. Default on Windows: installed Chrome, else Edge.
BROWSER_EXECUTABLE=

# Optional proxy per market, e.g. http://host:port if the market is geo-restricted
BETSSON_ES_PROXY_SERVER=
BETSSON_COM_PROXY_SERVER=
BETSSON_PE_PROXY_SERVER=

# --- Optional AI vision fallback ---
ANTHROPIC_API_KEY=
