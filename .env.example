# Copy to .env and fill in locally. In GitHub Actions these come from repository secrets.
# Never commit real values.

# Single market betsson.es by the organizer's decision (15/10).
MARKETS=betsson-es

# --- betsson.es (ES / EUR) ---
BETSSON_ES_FUNDED_USERNAME=
BETSSON_ES_FUNDED_PASSWORD=
BETSSON_ES_EMPTY_USERNAME=
BETSSON_ES_EMPTY_PASSWORD=
# Optional, e.g. http://host:port if betsson.es requires a Spanish IP
BETSSON_ES_PROXY_SERVER=

# --- Optional AI vision fallback ---
ANTHROPIC_API_KEY=
